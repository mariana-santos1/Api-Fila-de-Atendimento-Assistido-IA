# MySQL container (docker compose)
MYSQL_DATABASE=fila_ciclica
MYSQL_USER=dev
MYSQL_PASSWORD=dev
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306

# Application datasource
DB_URL=jdbc:mysql://localhost:3306/fila_ciclica?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=dev
DB_PASSWORD=dev

# Application security (JWT secret must have at least 32 characters)
JWT_SECRET=change-me-to-a-secret-with-at-least-32-characters
ADMIN_EMAIL=admin@fila.local
ADMIN_PASSWORD=admin12345
